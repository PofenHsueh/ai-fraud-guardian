# AWS API Gateway Stage Invoke URL（例如 https://abc123xyz.execute-api.ap-northeast-1.amazonaws.com/dev）
# 留空時，前端會自動使用內建的示範假資料（?mock=）運作
VITE_API_BASE_URL=

# AWS Cognito User Pool 設定（選填；設定後登入頁會呼叫 Cognito 驗證並支援 401 自動換發 Token）
VITE_COGNITO_REGION=ap-northeast-1
VITE_COGNITO_CLIENT_ID=

# 開發測試用固定 Cognito ID Token（選填；未走 Cognito 登入時可直接貼入 JWT 測試 API Gateway）
VITE_COGNITO_TOKEN=
